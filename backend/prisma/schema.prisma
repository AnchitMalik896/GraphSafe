generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
}

model Project {
  id            String   @id @default(uuid())
  name          String
  repositoryUrl String
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans Scan[]

  @@index([userId])
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Scan {
  id            String     @id @default(uuid())
  projectId     String
  status        ScanStatus @default(PENDING)
  riskScore     Float?
  scannedAt     DateTime?
  createdAt     DateTime   @default(now())
  completedAt   DateTime?
  manifestFiles String[]   @default([])
  ecosystems    String[]   @default([])

  // --- Phase 1: Security Findings Data Model ---
  // Denormalized read-optimized counters. Nothing writes these yet;
  // a future risk-scoring phase populates them from Finding rows.
  // Named riskScoreV2 to avoid colliding with the existing `riskScore`
  // Float field already used by riskScoring.service.ts / dashboard.service.ts.
  riskScoreV2   Int        @default(0)
  criticalCount Int        @default(0)
  highCount     Int        @default(0)
  mediumCount   Int        @default(0)
  lowCount      Int        @default(0)

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependencies Dependency[]
  riskReport   RiskReport?
  findings     Finding[]

  // Widened from @@index([projectId]): a composite index on
  // (projectId, status) still serves every existing projectId-only
  // lookup (leftmost-prefix rule) while also covering status-filtered
  // dashboard queries, so one index replaces two.
  @@index([projectId, status])
}

model Dependency {
  id              String  @id @default(uuid())
  scanId          String
  packageName     String
  version         String
  latestVersion   String?
  vulnerable      Boolean @default(false)
  deprecated      Boolean @default(false)
  popularityScore Float?

  scan     Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@index([scanId])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model RiskReport {
  id                 String    @id @default(uuid())
  scanId             String    @unique
  vulnerablePackages Int
  outdatedPackages   Int
  deprecatedPackages Int
  overallRiskScore   Float
  riskLevel          RiskLevel
  totalFindings      Int
  generatedAt        DateTime  @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

// --- Phase 1: Security Findings Data Model ---

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Finding {
  id             String   @id @default(uuid())
  scanId         String
  dependencyId   String

  advisoryId     String

  packageName    String
  packageVersion String

  title          String
  summary        String?

  severity       Severity

  fixedVersion   String?

  source         String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  scan       Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  dependency Dependency @relation(fields: [dependencyId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([dependencyId])
  @@index([severity])
}